{
  "title": "ShopFlow SAGA Dashboard",
  "uid": "shopflow-saga",
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "5s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Orders Created (total)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(increase(http_server_requests_seconds_count{uri='/api/orders',method='POST',job='order-service'}[1h]))", "legendFormat": "Orders"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "blue"}}}
    },
    {
      "id": 2, "type": "stat", "title": "Payments Succeeded",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(increase(http_server_requests_seconds_count{uri='/api/payments',method='POST',status='200',job='payment-service'}[1h]))", "legendFormat": "Success"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "green"}}}
    },
    {
      "id": 3, "type": "stat", "title": "Payments Failed (Compensation)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "sum(increase(http_server_requests_seconds_count{uri='/api/payments',method='POST',status!='200',job='payment-service'}[1h]))", "legendFormat": "Failures"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "red"}}}
    },
    {
      "id": 4, "type": "stat", "title": "Gateway Uptime",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "up{job='api-gateway'}", "legendFormat": "Gateway"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value","options": {"0": {"text": "DOWN","color": "red"},"1": {"text": "UP","color": "green"}}}]}}
    },
    {
      "id": 5, "type": "timeseries", "title": "HTTP Request Rate by Service",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "rate(http_server_requests_seconds_count{job='order-service'}[1m])", "legendFormat": "order-service {{uri}}"},
        {"expr": "rate(http_server_requests_seconds_count{job='payment-service'}[1m])", "legendFormat": "payment-service {{uri}}"}
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "HTTP Latency P99 (ms)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job='order-service'}[2m])) * 1000", "legendFormat": "order-service p99"},
        {"expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job='payment-service'}[2m])) * 1000", "legendFormat": "payment-service p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "id": 7, "type": "logs", "title": "Live Logs — All Services",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 12},
      "targets": [{"expr": "{app=~\"service-order|service-payment\"}", "legendFormat": ""}],
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true}
    }
  ]
}
